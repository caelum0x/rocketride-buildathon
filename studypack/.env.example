# Study Pack — environment for the check script and pipeline.
# Copy to .env and fill in. All pipeline vars MUST start with ROCKETRIDE_.

# RocketRide staging connection (from the client after you sign in).
ROCKETRIDE_URI=https://staging.rocketride.ai
ROCKETRIDE_APIKEY=

# Model provider key — your credits DO NOT cover model providers, so bring your own.
# The pipeline's llm_openai_1 node reads this.
ROCKETRIDE_OPENAI_KEY=

# Free model path (no provider bill): deploy studypack-ollama.pipe instead of
# studypack.pipe. Its llm_ollama_1 node reads ROCKETRIDE_OLLAMA_BASE (OpenAI-
# compatible Ollama endpoint) and defaults the model to llama3.1:8b.
ROCKETRIDE_OLLAMA_BASE=http://localhost:11434/v1
