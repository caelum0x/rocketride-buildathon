{
  "name": "@rocketride/studypack-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Study Pack — turn lecture material into an exam-ready study pack",
  "license": "MIT",
  "appManifest": {
    "id": "local.studypack",
    "name": "Study Pack",
    "description": "Turn lecture notes, transcripts, or slides into an exam-ready study pack.",
    "icon": "./src/icon.svg",
    "categories": [
      "ai"
    ],
    "mode": "free",
    "authenticated": false,
    "showStatusBar": true,
    "shells": [
      "oss"
    ]
  },
  "scripts": {
    "build": "rsbuild build",
    "build:prod": "rsbuild build --env-mode production"
  },
  "browserslist": [
    "chrome >= 81",
    "edge >= 83",
    "firefox >= 76",
    "safari >= 13"
  ],
  "dependencies": {
    "@module-federation/rsbuild-plugin": "^2.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rocketride": "workspace:*",
    "shell": "file:../../.rocketride/shell/shell.tgz"
  },
  "devDependencies": {
    "@rsbuild/core": "~2.0.11",
    "@rsbuild/plugin-react": "~2.0.1",
    "typescript": "^5.3.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7"
  }
}
